# Polaris environment configuration example
# Copy this file to .env and adjust values for your deployment.

# Server
HOST=0.0.0.0
PORT=4283
# Docker Compose host-side port. It does not change the application listener.
HOST_PORT=4283
# This release supports exactly one application worker and replica.
POLARIS_RUNTIME_MODE=standalone
POLARIS_REPLICA_COUNT=1
WORKERS=1
# Comma-separated browser origins allowed to call the API from another origin.
# Leave empty for same-origin console usage. Use explicit origins in production.
CORS_ORIGINS=
CORS_ORIGIN_REGEX=

# Authentication
# Leave password variables empty on first run to use the web setup screen.
# After setup, Polaris stores the password in its configured storage.
# For non-interactive deployments, set PANEL_PASSWORD.
# Public client integrations should use an API key with the sk-polaris- prefix.
# API_KEY=sk-polaris-change-me
# PANEL_PASSWORD=your_panel_password
# Optional fixed token for first-time setup from a remote browser. When omitted,
# Polaris prints an ephemeral setup token to the application logs.
# SETUP_TOKEN=replace-with-a-long-random-value
PANEL_SESSION_TTL_SECONDS=86400
# Leave empty for automatic HTTPS detection through X-Forwarded-Proto. Set to
# true to require secure cookies, or false only for a deliberately HTTP-only host.
PANEL_COOKIE_SECURE=
PANEL_LOGIN_WINDOW_SECONDS=300
PANEL_LOGIN_MAX_ATTEMPTS=10
# Bound the in-memory login limiter when exposed to many distinct client addresses.
PANEL_LOGIN_MAX_TRACKED_CLIENTS=10000
# Reject oversized fixed-length and chunked HTTP request bodies.
MAX_REQUEST_BODY_MB=64
# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY_HEADERS=false

# Optional OIDC team access (advanced, disabled by default).
# The browser flow remains deny-by-default until this switch and every required
# trust setting are valid. Keep it disabled until your IdP mapping is reviewed.
# See docs/oidc-foundation.md for configuration and recovery requirements.
OIDC_ENABLED=false
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=polaris
# Configure exactly one secret source. File paths must be absolute regular files.
# OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/polaris-oidc
# OIDC_REDIRECT_URI=https://gateway.example.com/api/identity/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_ID_TOKEN_SIGNING_ALGORITHMS=RS256
# OIDC_SUBJECT_CLAIM=sub
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISPLAY_NAME_CLAIM=name
# OIDC_EMAIL_CLAIM=email
# OIDC_GROUPS_CLAIM=groups
# Exact JSON object mapping IdP group values to viewer, operator, or security_admin.
# There is no default role, and owner is forbidden.
# OIDC_ROLE_MAPPINGS={"gateway-viewers":"viewer","gateway-operators":"operator"}
# OIDC_ALLOWED_ENDPOINT_ORIGINS=
# OIDC_ALLOWED_PRIVATE_HOSTS=
# OIDC_CONNECT_TIMEOUT_SECONDS=5
# OIDC_READ_TIMEOUT_SECONDS=10
# OIDC_MAX_RESPONSE_BYTES=262144
# OIDC_JWKS_TTL_SECONDS=300
# OIDC_START_WINDOW_SECONDS=300
# OIDC_START_MAX_ATTEMPTS=20
# OIDC_START_MAX_TRACKED_CLIENTS=10000

# Storage
# Single-instance storage uses local files under CREDENTIALS_DIR.
# Docker Compose persists /app/backend/data in the named polaris-data volume.
# Direct docker run deployments should persist /app/backend/data/creds and logs.
# External databases are optional storage backends, but this release still
# requires one worker and one application replica.
# Configure at most one external database. Explicit database failures stop startup
# instead of falling back to local SQLite.
CREDENTIALS_DIR=./backend/data/creds
MONGODB_URI=
MONGODB_DATABASE=polaris
POSTGRESQL_URI=

# Optional environment credential import.
# Paste raw JSON or use the *_B64 variants for base64-encoded JSON.
# CODE_ASSIST_CREDENTIALS_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","project_id":"..."}
# CREDENTIALS_JSON={"token":"...","refresh_token":"...","client_id":"...","client_secret":"...","project_id":"..."}

# Optional OAuth client overrides for interactive credential creation.
# Built-in desktop OAuth clients are provided by default; override only when needed.
# Google Antigravity settings can also be configured from the Providers page and stored locally.
# CODE_ASSIST_CLIENT_ID=
# CODE_ASSIST_CLIENT_SECRET=
# ANTIGRAVITY_CLIENT_ID=
# ANTIGRAVITY_CLIENT_SECRET=
# ANTIGRAVITY_USER_AGENT=antigravity/cli/1.0.1 windows/amd64
# ANTIGRAVITY_PAYLOAD_USER_AGENT=antigravity

# Network and upstream endpoints
PROXY=
CODE_ASSIST_ENDPOINT=https://cloudcode-pa.googleapis.com
ANTIGRAVITY_API_URL=https://daily-cloudcode-pa.googleapis.com
GOOGLE_AI_STUDIO_API_URL=https://generativelanguage.googleapis.com
# Grok Build includes a built-in public OAuth client. SpaceXAI Console uses the API endpoint below.
# Override these xAI transport settings only when needed.
XAI_API_URL=https://api.x.ai/v1
XAI_OAUTH_API_URL=https://cli-chat-proxy.grok.com/v1
XAI_OAUTH_ISSUER=https://auth.x.ai
# XAI_CLIENT_ID=
# XAI_USER_AGENT=grok-cli/polaris
OAUTH_URL=https://oauth2.googleapis.com
GOOGLE_APIS_URL=https://www.googleapis.com
RESOURCE_MANAGER_URL=https://cloudresourcemanager.googleapis.com
SERVICE_USAGE_URL=https://serviceusage.googleapis.com
# OpenAI Platform uses the public OpenAI API. Codex uses the built-in ChatGPT
# device authorization flow and normally does not require endpoint overrides.
OPENAI_API_URL=https://api.openai.com/v1
CODEX_API_URL=https://chatgpt.com/backend-api/codex
CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
# CODEX_AUTH_BASE=https://auth.openai.com
# CODEX_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# CODEX_USER_AGENT=codex_cli_rs/0.0.0 (Unknown 0; unknown)
# Claude Platform uses Anthropic API keys. Claude Code uses the built-in PKCE
# OAuth client. These settings can also be managed from the Providers page.
ANTHROPIC_API_URL=https://api.anthropic.com/v1
CLAUDE_OAUTH_AUTHORIZE_URL=https://claude.ai/oauth/authorize
CLAUDE_OAUTH_TOKEN_URL=https://api.anthropic.com/v1/oauth/token
# CLAUDE_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# CLAUDE_USER_AGENT=claude-cli/polaris
# Ollama endpoints and optional API keys are stored per connection from the
# Providers page, so one gateway can route across multiple Ollama servers.
# Required only when enabling Vertex anonymous routing.
VERTEX_ANON_API_KEY=

# Fallback, retry, and health behavior
AUTO_DISABLE=false
AUTO_DISABLE_ERROR_CODES=403
# The RETRY_429_* names are retained for backward compatibility; they apply to
# rate limits and other transient upstream statuses (408, 409, 429, 500, 502, 503, 504).
RETRY_429_ENABLED=true
RETRY_429_MAX_RETRIES=5
RETRY_429_INTERVAL=1
SWITCH_CREDENTIAL_ENABLED=true

# Cross-provider routing
# balanced spreads traffic by health and concurrency. priority prefers one
# provider and falls back automatically when it is unavailable or incompatible.
# weighted spreads randomly using the optional per-credential weight field.
# least_latency prefers credentials with the fastest recent responses.
# lowest_cost prefers local/OAuth quota credentials before metered API keys.
ROUTING_STRATEGY=balanced
PREFERRED_PROVIDER=
UPSTREAM_TIMEOUT_SECONDS=300

# Response cache (exact match)
# Caches deterministic (temperature == 0) non-streaming responses in memory.
# Identical requests are answered by the gateway without an upstream call.
RESPONSE_CACHE_ENABLED=false
RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_MAX_ENTRIES=1000

# Guardrails (pre-call safety pipeline)
# When enabled, prompt-injection attempts and blocked keywords are rejected
# with HTTP 400 before any provider is called, and PII (emails, cards,
# API keys) is masked from outbound request text.
GUARDRAILS_ENABLED=false
GUARDRAILS_PII_MASKING_ENABLED=true
GUARDRAILS_INJECTION_DETECTION_ENABLED=true
# Comma-separated list of case-insensitive keywords that block a request.
GUARDRAILS_BLOCKED_KEYWORDS=

# FinOps
# Per-call USD costs are computed from the built-in model pricing table.
# Override or extend prices by creating model_pricing.json inside
# CREDENTIALS_DIR, for example:
#   {"my-model": {"input": 1.0, "output": 4.0, "cache_read": 0.25}}
# Prices are USD per 1 million tokens. Virtual API keys with budgets and
# rate limits are managed from the panel API at /api/virtual-keys.
# The public LiteLLM catalog is cached locally; failed refreshes retain the
# last valid snapshot and never block inference.
PRICING_SYNC_ENABLED=true
PRICING_SYNC_INTERVAL_HOURS=24

# Translation and response shaping
COMPATIBILITY_MODE=false
RETURN_THOUGHTS_TO_FRONTEND=true
STREAM_TO_NONSTREAM=true
ANTI_TRUNCATION_MAX_ATTEMPTS=3

# Context optimization
# Oversized histories are trimmed only at safe user-turn boundaries. System
# instructions, tool definitions, and the configured recent turns are retained.
TOKEN_COMPRESSION_ENABLED=true
TOKEN_COMPRESSION_THRESHOLD=32000
TOKEN_COMPRESSION_TARGET=24000
TOKEN_COMPRESSION_MIN_RECENT_TURNS=4

# Observability
LOG_LEVEL=info
LOG_MAX_MB=10
LOG_BACKUP_COUNT=3
# External exporters are opt-in. Prometheus also requires a token of at least
# 32 UTF-8 bytes and scrapes must send "Authorization: Bearer <token>".
PROMETHEUS_EXPORT_ENABLED=false
METRICS_TOKEN=
# OTLP/HTTP exports aggregate, content-free gauges only. HTTPS is mandatory.
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORT_INTERVAL_SECONDS=60
# Optional comma-separated authorization, api-key, or x-api-key entries.
OTEL_EXPORTER_OTLP_HEADERS=
# Optional Langfuse trace export. Successful calls emit a generation event
# with model, provider, token counts, and latency. Prompt and response
# bodies never leave the gateway. Disabled while the keys are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# In Docker, persist /app/backend/data/logs with a host volume such as
# /opt/polaris/logs.
LOG_FILE=./backend/data/logs/polaris.log

# Optional keep-alive ping for platforms that suspend idle services.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=60
