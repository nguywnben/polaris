# Copy this file to .env in the repository root, then change only what you need.
# Keep the exact release tag for reproducible installs and reversible updates.
# Unpublished target: resolve legacy tag/image collisions before pulling this version.
# See docs/releases/1.0.0-preparation.md; use a separately named local test image for rehearsal.
IMAGE=nguywnben/polaris:1.0.0
HOST_PORT=4283
DATA_VOLUME=polaris-data
LOG_LEVEL=info

# Leave API_KEY and PANEL_PASSWORD empty for interactive first-run setup.
API_KEY=
PANEL_PASSWORD=

# Required only when the unconfigured console is reached through a non-loopback host.
# Use a unique value of at least 24 characters; never commit the populated .env file.
SETUP_TOKEN=
