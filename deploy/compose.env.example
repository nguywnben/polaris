# Copy this file to .env in the repository root, then change only what you need.
# Keep the exact release tag for reproducible installs and reversible updates.
# Pull only the matching published Polaris release; archived tags are not substitutes.
# See docs/releases/1.0.0-preparation.md; use a separately named local test image for rehearsal.
IMAGE=nguywnben/polaris:1.0.0
HOST_PORT=4283
DATA_VOLUME=polaris-data
LOG_LEVEL=info

# Leave API_KEY and PANEL_PASSWORD empty for interactive first-run setup.
API_KEY=
PANEL_PASSWORD=

# Required for remote setup and when Docker NAT hides the local client address.
# Use a unique value of at least 24 characters; never commit the populated .env file.
SETUP_TOKEN=

# HTTPS is recommended. Explicitly accept unencrypted remote setup only if needed.
# WARNING: HTTP can expose setup tokens, passwords and session cookies in transit.
# For local-only HTTP, use HOST_PORT=127.0.0.1:4283 and explicitly set this to true.
SETUP_ALLOW_INSECURE_HTTP=false
